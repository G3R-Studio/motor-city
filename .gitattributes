# Motor City repository attributes
# Keep source/YAML files normalized while large binary and near-limit authored
# assets use Git LFS.

* text=auto

# Project/source text
*.cs text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.json text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Unity text serialization
*.meta text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.controller text eol=lf
*.anim text eol=lf
*.lighting text eol=lf
*.unity text eol=lf
*.prefab text eol=lf

# Large binary source/content assets
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.rar filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text

# These authored/generated city files are currently close to GitHub's 100 MiB
# per-file limit, so future revisions must be stored through LFS.
Assets/LocalGenerated/FCG_Workbench.unity filter=lfs diff=lfs merge=lfs -text
Assets/Resources/MotorCity/Environment/CityVisual.prefab filter=lfs diff=lfs merge=lfs -text
Assets/Resources/MotorCity/Environment/FCGTrafficCars/*.prefab filter=lfs diff=lfs merge=lfs -text

# Small runtime audio clips restored from project history stay directly in Git.
Assets/Resources/MotorCity/Audio/CarEngine.wav -filter -diff -merge -text
Assets/Resources/MotorCity/Audio/TireSkid.ogg -filter -diff -merge -text
